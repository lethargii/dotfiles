{
  "layer": "top",
  "position": "bottom",
  "modules-left": ["image#niri", "group/whoami", "custom/pkg"],
  "modules-right": ["tray", "group/keyboard", "group/swaync", "group/networking", "group/power", "clock"],



  "image#niri": {
    "path": "/home/lethargii/.config/waybar/niri-logo.svg",
    "size": 32,
    "on-click": "/home/lethargii/.config/niri/wofi.sh"
  },




  "group/whoami": {
    "orientation": "inherit",
    "modules": ["user", "custom/username"]
  },
  "user": {
    "format": "",
    "interval": 60,
    "height": 22,
    "width": 22,
    "icon": true,
    "on-click": "~/.config/waybar/powermenu.py",
  },
  "custom/username": {
    "exec": "whoami",
    "tooltip": false,
    "on-click": "~/.config/waybar/powermenu.py",
  },



  "custom/pkg": {
    "format": "{icon}",
    "interval": 3600,
    "format-icons": {
      "updates": "",
      "no_updates": "",
    },
    "tooltip": true,
    "tooltip-format": "{}",
    "exec": "~/.config/waybar/pkg.py",
    "exec-if": "which dnf",
    "on-click": "~/.config/waybar/pkg.sh",
    "return-type": "json",
    "signal": 1,
  },




  "tray": {
    "spacing": 10,
  },



  "group/keyboard": {
    "orientation": "inherit",
    "modules": ["custom/ibus"],
  },
  "keyboard-state": {
    "numlock": true,
    "capslock": true,
    "format": {
      "numlock": "N {icon}",
      "capslock": "C {icon} "
    },
    "format-icons": {
      "locked": "",
      "unlocked": ""
    }
  },
  "custom/ibus": {
    "format": "{}",
    "exec": "~/.config/waybar/ibus.sh",
    "exec-if": "which ibus",
    "on-click": "~/.config/waybar/ibus.py",
    "interval": 1,
  },




  "group/swaync": {
    "orientation": "inherit",
    "modules": ["custom/notification", "wireplumber#sink", "wireplumber#source", "backlight"]
  },
  "custom/notification": {
    "tooltip": true,
    "format": "<span size='16pt'>{icon}</span>",
    "format-icons": {
      "notification": "",
      "none": "",
      "dnd-notification": "",
      "dnd-none": "",
      "inhibited-notification": "",
      "inhibited-none": "",
      "dnd-inhibited-notification": "",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "wireplumber#sink": {
    "node-type": "Audio/Sink",
    "format": "{icon}",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", ""]
    },
    "tooltip-format": "{volume}%",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
  },
  "wireplumber#source": {
    "node-type": "Audio/Source",
    "format": "{icon}",
    "format-muted": "󰍭",
    "format-icons": {
      "default": ["󰍬"]
    },
    "tooltip-format": "{volume}%",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
  },
  "backlight": {
    "format": "{icon}",
    "format-icons": {
      "default": ["󰃚", "󰃛", "󰃜", "󰃝", "󰃞", "󰃟", "󰃠"]
    },
    "tooltip-format": "{percent}%",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
  },




  "group/networking": {
    "orientation": "inherit",
    "modules": ["network", "bluetooth"]
  },
  "network": {
    "interface": "wlp4s0",
    "format-wifi": "{icon}",
    "format-ethernet": "{icon}",
    "format-disconnected": "{icon}", //An empty format will hide the module.
    "format-icons": {
      "wifi": [
        "󰤯",
        "󰤟",
        "󰤢",
        "󰤥",
        "󰤨"
      ],
      "ethernet": "󰈀",
      "disabled": "󰤭",
      "disconnected": "󰤩"
    },
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "{ifname} ",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "kitty --class wlctl -e .cargo/bin/wlctl"
  },
  "bluetooth": {
    "format-on": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format-disabled": "Bluetooth is disabled",
    "tooltip-format-off": "Bluetooth is turned off",
    "tooltip-format-on": "No device connected",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device alias} {device_address}",
    "tooltip-format-enumerate-connected-battery": "{device alias} {device_address} | Battery: {device_battery_percentage}%",
    "on-click": "flatpak run io.github.kaii_lb.Overskride"
  },




  "group/power": {
    "orientation": "inherit",
    "modules": ["battery", "power-profiles-daemon"]
  },
  "battery": {
    "format": "{icon}",
    "states": {
      "warning": 20,
      "critical": 10
    },
    "tooltip-format": "{capacity}% - {time} until fully discharged",
    "tooltip-format-charging": "{capacity}% - {time} until fully charged",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "format-charging": "󰂄",
    "format-plugged": "󰚥",
    "format-critical": "󰂃",
    "on-click": "xfce4-power-manager-settings",
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },





  "clock": {
    "format": "{:L%a %d %b %H:%M}",
    "tooltip": true,
    "tooltip-format": "{:%d/%m/%Y}",
    "locale": "fr_FR.UTF-8",
    "on-click": "gnome-calendar",
  }
}
