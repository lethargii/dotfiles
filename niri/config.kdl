include "./colors.kdl"

environment {
  SUDO_EDITOR "/usr/bin/nvim"
}

input {
    keyboard {
        xkb {
          layout "us"
          variant "intl"
        }
    }
    touchpad {
        tap
        natural-scroll
    }
    mouse {
    }
    trackpoint {
    }
}

/-output "eDP-1" {
    mode "1920x1080@120.030"
    scale 2
    transform "normal"
    position x=1280 y=0
}

prefer-no-csd

layout {
    gaps 16
    center-focused-column "never"
    default-column-width { proportion 0.5; }
    focus-ring {
        off
    }
    border {
        on
        urgent-color "#9b0000"
    }
    shadow {
        // on

        offset x=0 y=5
        color "#0007"
    }
    struts {
    }
}

workspace "code"

workspace "work"

workspace "music"

workspace "discord"

workspace "steam"

workspace "mail"

window-rule {
  geometry-corner-radius 12
  clip-to-geometry true
  draw-border-with-background false
}

window-rule {
  match app-id=r#"Cavasik"#
  open-on-workspace "code"
  default-column-width { proportion 0.45; }
  default-window-height { proportion 0.7; }
}

window-rule {
  match app-id=r#"wlctl"#
  open-floating true
}

window-rule {
  match at-startup=true app-id=r#"kitty"#
  open-on-workspace "code"
}

window-rule {
  match app-id=r#"kitty"#
  default-column-width { proportion 0.55; }
}

window-rule {
  match at-startup=true app-id=r#"Papers"#
  open-on-workspace "code"
}

window-rule {
  match app-id=r#"Papers"#
  default-column-width { proportion 0.45; }
}

window-rule {
  match at-startup=true app-id=r#"firefox"#
  open-on-workspace "code"
}

window-rule {
  match app-id=r#"firefox"#
  default-column-width { proportion 0.55; }
  opacity 0.9
}

window-rule {
  match app-id=r#"harmonoid"#
  open-on-workspace "music"
  open-maximized true
  opacity 0.9
}

window-rule {
  match app-id=r#"vesktop"#
  open-on-workspace "discord"
  open-maximized true
  opacity 1.0
}

window-rule {
  match app-id=r#"steam"#
  open-on-workspace "steam"
  open-maximized true
  opacity 0.9
}

window-rule {
  match app-id=r#"geary"#
  open-on-workspace "mail"
  open-maximized true
  opacity 0.85
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
}

window-rule {
  match app-id=r#"Calendar"#
  open-floating true
}

window-rule {
  match app-id=r#"MissionCenter"#
  open-floating true
  default-column-width { proportion 0.7; }
  default-window-height { proportion 0.8; }
}

window-rule {
  match app-id=r#"nemo"#
  open-floating true
  default-column-width { proportion 0.7; }
  default-window-height { proportion 0.8; }
}

window-rule {
  match app-id=r#"Overskride"#
  open-floating true
  default-column-width { proportion 0.7; }
  default-window-height { proportion 0.8; }
}

window-rule {
  match app-id=r#"power-manager"#
  open-floating true
  default-column-width { proportion 0.7; }
  default-window-height { proportion 0.8; }
}

window-rule {
  match app-id=r#"Asunder"#
  opacity 0.85
}

window-rule {
  match app-id=r#"nemo"#
  opacity 0.85
}

window-rule {
  match app-id=r#"xfce"#
  opacity 0.85
}

window-rule {
  match app-id=r#"xfburn"#
  opacity 0.85
}

window-rule {
  match app-id=r#"Orion"#
  opacity 0.9
  default-column-width { proportion 0.65; }
}

window-rule {
  match app-id=r#"anki"#
  opacity 0.9
}

spawn-at-startup "waybar"

spawn-at-startup "swaybg" "-i" ".config/background"

spawn-at-startup "swaync"

spawn-at-startup "/usr/libexec/polkit-mate-authentication-agent-1"

spawn-at-startup "ibus" "start"

spawn-sh-at-startup "~/.config/niri/script.sh"

spawn-at-startup "geary"

spawn-at-startup "flatpak" "run" "dev.vencord.Vesktop"

spawn-at-startup "flatpak" "run" "ch.protonmail.protonmail-bridge" "--no-window"

spawn-at-startup "flatpak" "run" "com.valvesoftware.Steam"

spawn-at-startup "harmonoid"

spawn-at-startup "xfce4-power-manager"

hotkey-overlay {
  skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
    draw-border-with-background false
    open-maximized-to-edges false
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+T hotkey-overlay-title="Open a Terminal: alacritty" { spawn "kitty"; }
    Mod+F { spawn "nemo"; }
    Mod+D hotkey-overlay-title="Run an Application: wofi" { spawn-sh "/home/lethargii/.config/niri/wofi.sh"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "/home/lethargii/.config/niri/audio_raise.sh"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "/home/lethargii/.config/niri/audio_lower.sh"; }
    XF86AudioMute        allow-when-locked=true { spawn "/home/lethargii/.config/niri/audio_mute.sh"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "/home/lethargii/.config/niri/brightness_up.sh"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "/home/lethargii/.config/niri/brightness_down.sh"; }
    Mod+O repeat=false { toggle-overview; }
    Mod+Q repeat=false { close-window; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+Minus { set-column-width "-5%"; }
    Mod+Equal { set-column-width "+5%"; }
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+W { toggle-column-tabbed-display; }
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { spawn "flatpak" "run" "io.missioncenter.MissionCenter"; }
    Mod+Shift+P { power-off-monitors; }
}
